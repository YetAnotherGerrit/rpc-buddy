<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.YetAnotherGerrit.RpcBuddy</id>
  <name>RPC Buddy</name>
  <summary>Show what you play and listen to as Discord Rich Presence</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.yetanothergerrit">
    <name>YetAnotherGerrit</name>
  </developer>
  <description>
    <p>
      RPC Buddy shows the Steam game you are playing as your Discord activity —
      with the game's official name and artwork — even when Discord runs as a
      Flatpak and cannot detect games itself.
    </p>
    <p>
      It also shows the music you listen to in players such as Deezer or TIDAL,
      including music websites in your browser.
    </p>
  </description>
  <launchable type="desktop-id">io.github.YetAnotherGerrit.RpcBuddy.desktop</launchable>
  <url type="homepage">https://github.com/YetAnotherGerrit/rpc-buddy</url>
  <url type="bugtracker">https://github.com/YetAnotherGerrit/rpc-buddy/issues</url>
  <url type="vcs-browser">https://github.com/YetAnotherGerrit/rpc-buddy</url>
  <url type="contribute">https://github.com/YetAnotherGerrit/rpc-buddy/blob/main/CONTRIBUTING.md</url>
  <screenshots>
    <screenshot type="default">
      <caption>Your games and music, as Discord shows them</caption>
      <image>https://raw.githubusercontent.com/YetAnotherGerrit/rpc-buddy/v0.1.0/docs/screenshots/main-light.png</image>
    </screenshot>
    <screenshot>
      <caption>Follows your desktop's dark theme</caption>
      <image>https://raw.githubusercontent.com/YetAnotherGerrit/rpc-buddy/v0.1.0/docs/screenshots/main-dark.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.1" date="2026-11-24">
      <description>
        <p>A game no longer stays on Discord forever if Steam crashed while it was running; games are shown for at most 12 hours per session.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-22">
      <description>
        <p>First public test version.</p>
      </description>
    </release>
  </releases>
</component>
